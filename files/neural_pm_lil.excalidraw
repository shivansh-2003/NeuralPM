    {
      "type": "text",
      "id": "pg_code",
      "x": 84,
      "y": 488,
      "width": 650,
      "height": 140,
      "text": "CREATE TABLE memory_events (\n  id UUID PRIMARY KEY,  event_type VARCHAR(50),  agent_source VARCHAR(50),\n  metadata JSONB,       relevance_score FLOAT DEFAULT 1.0,\n  memory_tier VARCHAR(20) DEFAULT 'active',  -- active | compressed | archived\n  superseded_by UUID REFERENCES memory_events(id),\n  embedding VECTOR(1024)   -- Qwen embedding for semantic search\n);",
      "originalText": "CREATE TABLE memory_events (\n  id UUID PRIMARY KEY,  event_type VARCHAR(50),  agent_source VARCHAR(50),\n  metadata JSONB,       relevance_score FLOAT DEFAULT 1.0,\n  memory_tier VARCHAR(20) DEFAULT 'active',  -- active | compressed | archived\n  superseded_by UUID REFERENCES memory_events(id),\n  embedding VECTOR(1024)   -- Qwen embedding for semantic search\n);",
