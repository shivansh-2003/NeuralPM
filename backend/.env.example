# Copy to .env and adjust. Loaded by memory_agent/config.py via pydantic-settings.
# Run:  cp .env.example .env   then fill in values.

# --- Postgres ---
# Schema is Alembic-managed: run `alembic upgrade head` from backend/.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuralpm

# --- Qdrant (vector store) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=neuralpm_memories

# --- FalkorDB (graph store) ---
# FalkorDB uses the Redis wire protocol. docker-compose spins it up on 6379.
# Each user_id gets its own isolated graph: mem0_{user_id}
# No credentials needed for local Docker — leave blank or omit.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_DATABASE=mem0

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBED_MODEL=qwen3-embedding:0.6b

# IMPORTANT: must match the actual output dimension of EMBED_MODEL.
# qwen3-embedding:0.6b -> 1024,  :4b -> 2560,  :8b -> 4096 (check with the snippet in README).
EMBED_DIMS=1024
